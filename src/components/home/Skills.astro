---
import type { CollectionEntry } from 'astro:content';
import { sections, type Lang } from '../../i18n/routes';
import { useTranslations, type UiKeyOf } from '../../i18n/utils';

interface Props {
  lang: Lang;
  groups: CollectionEntry<'skills'>[];
  languages: string;
}

const { lang, groups, languages } = Astro.props;
const t = useTranslations(lang);
---

<section id={sections.skills[lang]} aria-labelledby="skills-title" class="py-16 lg:py-24">
  <div class="container-site">
    <h2 id="skills-title" class="section-title">{t('skills.title')}</h2>
    <div class="mt-8 grid gap-7 lg:mt-10 lg:grid-cols-3 lg:gap-x-12 lg:gap-y-10">
      {
        groups.map((group) => (
          <section aria-labelledby={`skills-${group.id}`} class="lg:border-t lg:border-border lg:pt-5">
            <h3 id={`skills-${group.id}`} class="font-bold lg:text-[17px]">
              {t(`skills.group.${group.id}` as UiKeyOf<'skills.group.'>)}
            </h3>
            <ul class="mt-3.5 flex flex-wrap gap-2">
              {group.data.items.map((item) => (
                <li class="tag-tech">{item.name}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="mt-10 border-t border-border pt-5 text-text-secondary lg:border-0 lg:pt-0 lg:text-[17px]">
      <strong class="font-bold text-text">{t('experience.languages')}:</strong>
      {languages}
    </p>
  </div>
</section>
