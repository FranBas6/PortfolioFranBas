---
import { getEntry } from 'astro:content';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Seo from '../components/layout/Seo.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import type { Alternates, Lang, Section } from '../i18n/routes';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URL of this page in each language; drives hreflang and the switcher. */
  alternates?: Alternates;
  noindex?: boolean;
  /**
   * full: header and footer. minimal: only a bar with the name (404 and the
   * root fallback, where the visitor's language is unknown).
   */
  chrome?: 'full' | 'minimal';
  /** Section marked as current in the header. */
  current?: Section;
}

const {
  lang,
  title,
  description,
  alternates,
  noindex = false,
  chrome = 'full',
  current,
} = Astro.props;
const site = (await getEntry('site', lang))?.data;
if (!site) throw new Error(`Missing src/content/site/${lang}.yaml`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0f24" />
    <link
      rel="preload"
      href="/fonts/manrope-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      lang={lang}
      title={title}
      description={description}
      alternates={alternates}
      noindex={noindex}
      ogImage={site.og.image}
      ogAlt={site.og.alt}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    {
      chrome === 'full' ? (
        <>
          <SkipLink lang={lang} />
          <Header lang={lang} alternates={alternates} current={current} />
        </>
      ) : (
        <div class="border-b border-border bg-bg-base">
          <div class="container-site flex h-16 items-center lg:h-[72px]">
            <p class="text-base font-extrabold tracking-[-0.01em] lg:text-[17px]">{site.name}</p>
          </div>
        </div>
      )
    }
    <main id="content" class="flex-1">
      <slot />
    </main>
    {chrome === 'full' && <Footer lang={lang} alternates={alternates} />}
  </body>
</html>
