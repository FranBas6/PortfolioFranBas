---
/*
 * Project page, shared by /es/proyectos/<slug>/ and /en/projects/<slug>/.
 * Personal projects only. Phase 1: semantic HTML without design.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projectPath, sectionPath, type Lang } from '../i18n/routes';
import {
  formatPeriod,
  getProjectAlternates,
  getProjects,
  projectKey,
  useTranslations,
  type Project,
} from '../i18n/utils';

interface Props {
  lang: Lang;
  entry: Project;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const project = entry.data;

const alternates = await getProjectAlternates(entry);
// Free Markdown body (e.g. data attributions), shown after the facts.
const { Content } = await render(entry);

const all = await getProjects(lang);
const index = all.findIndex((p) => projectKey(p) === projectKey(entry));
const previous = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;

const skillName = new Map(
  (await getCollection('skills')).flatMap((group) =>
    group.data.items.map((item) => [item.id, item.name] as const),
  ),
);
---

<BaseLayout
  lang={lang}
  title={project.seo?.title ?? project.title}
  description={project.seo?.description ?? project.summary}
  alternates={alternates}
>
  <article>
    <header>
      <p><a href={sectionPath(lang, 'projects')}>{t('project.back')}</a></p>
      <p>{project.platforms.map((p) => t(`platform.${p}`)).join(' · ')}</p>
      <h1>{project.title}</h1>
      <p>{project.summary}</p>
    </header>

    <section aria-labelledby="facts-title">
      <h2 id="facts-title">{t('project.facts')}</h2>
      <dl>
        <dt>{t('project.period')}</dt>
        <dd>{formatPeriod(project.period, lang)}</dd>
        <dt>{t('project.role')}</dt>
        <dd>{project.role}</dd>
        <dt>{t('project.platforms')}</dt>
        <dd>{project.platforms.map((p) => t(`platform.${p}`)).join(', ')}</dd>
        <dt>{t('project.links')}</dt>
        <dd>
          <a href={project.links.demo}>{t('projects.demo')}</a>{' '}
          <a href={project.links.repo}>{t('projects.repo')}</a>
        </dd>
      </dl>
      {project.uiNote && lang === 'en' && <p>{t('project.uiNote')}</p>}
    </section>

    <Image src={project.cover.src} alt={project.cover.alt} widths={[640, 1024, 1280]} sizes="(min-width: 1120px) 1120px, 100vw" />

    <section aria-labelledby="what-title">
      <h2 id="what-title">{t('project.whatItIs')}</h2>
      <p>{project.whatItIs}</p>
    </section>

    <section aria-labelledby="did-title">
      <h2 id="did-title">{t('project.whatIDid')}</h2>
      <ul>
        {project.whatIDid.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    {
      project.metrics && (
        <section aria-labelledby="metrics-title">
          <h2 id="metrics-title">{t('project.metrics')}</h2>
          <dl>
            {project.metrics.map((metric) => (
              <>
                <dt>{metric.label}</dt>
                <dd>{metric.value}</dd>
              </>
            ))}
          </dl>
        </section>
      )
    }

    <section aria-labelledby="stack-title">
      <h2 id="stack-title">{t('project.stack')}</h2>
      <ul>
        {project.stack.map((id) => <li>{skillName.get(id)}</li>)}
      </ul>
    </section>

    <section aria-labelledby="why-title">
      <h2 id="why-title">{t('project.whyItMatters')}</h2>
      <p>{project.whyItMatters}</p>
    </section>

    {
      project.gallery && (
        <section aria-labelledby="gallery-title">
          <h2 id="gallery-title">{t('project.gallery')}</h2>
          <ul>
            {project.gallery.map((shot) => (
              <li>
                <Image src={shot.src} alt={shot.alt} widths={[360, 720]} sizes="(min-width: 768px) 50vw, 100vw" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="how-title">
      <h2 id="how-title">{t('project.howIWork')}</h2>
      <ul>
        {project.howIWork.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    <Content />

    <nav aria-label={t('projects.title')}>
      <ul>
        {
          previous && (
            <li>
              {t('project.previous')}:{' '}
              <a href={projectPath(lang, previous.data.slug)}>{previous.data.title}</a>
            </li>
          )
        }
        {
          next && (
            <li>
              {t('project.next')}:{' '}
              <a href={projectPath(lang, next.data.slug)}>{next.data.title}</a>
            </li>
          )
        }
      </ul>
    </nav>

    <p><a href={sectionPath(lang, 'contact')}>{t('project.contactCta')}</a></p>
  </article>
</BaseLayout>
