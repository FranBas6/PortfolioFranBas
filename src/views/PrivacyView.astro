---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { staticAlternates, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entry = await getEntry('legal', `${lang}/privacy`);
if (!entry) throw new Error(`Missing src/content/legal/${lang}/privacy.md`);
const { Content } = await render(entry);
---

<BaseLayout
  lang={lang}
  title={entry.data.seo.title ?? entry.data.title}
  description={entry.data.seo.description}
  alternates={staticAlternates.privacy}
>
  <article>
    <h1>{entry.data.title}</h1>
    <p><time datetime={entry.data.updated}>{entry.data.updated}</time></p>
    <Content />
  </article>
</BaseLayout>
