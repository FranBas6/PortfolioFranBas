---
import { getEntry } from 'astro:content';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { privacyPath, type Alternates, type Lang } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  alternates?: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('site', lang))?.data;
if (!site) throw new Error(`Missing src/content/site/${lang}.yaml`);

const links = [
  { label: 'GitHub', href: site.links.github },
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: t('contact.email'), href: `mailto:${site.email}` },
  { label: t('nav.cv'), href: site.cv },
  { label: t('footer.privacy'), href: privacyPath(lang) },
];
---

<footer class="border-t border-border bg-bg-deep">
  <div
    class="container-site flex flex-col gap-5 py-8 lg:flex-row lg:items-center lg:justify-between"
  >
    <div>
      <p class="font-extrabold">{site.name}</p>
      <p class="text-sm text-text-muted">{site.role}</p>
    </div>
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:gap-6">
      <nav aria-label={t('footer.links')}>
        <ul class="flex flex-wrap gap-x-6 gap-y-1">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="link-underline inline-flex min-h-11 items-center text-[15px] font-semibold text-text-secondary"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <span aria-hidden="true" class="hidden h-6 w-px bg-border lg:block"></span>
      <LanguageSwitcher lang={lang} alternates={alternates} class="-ml-2.5 lg:ml-0" />
    </div>
  </div>
</footer>
