---
/*
 * "ES / EN": a plain link to the same page in the other language. No
 * JavaScript, no cookies, no flags. The current language is not a link,
 * is underlined in accent and carries aria-current.
 */
import { homePath, languages, type Alternates, type Lang } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  /** URL of this page in each language. Pages without one link to the home. */
  alternates?: Alternates;
  class?: string;
}

const { lang, alternates, class: className } = Astro.props;
const t = useTranslations(lang);
const hrefFor = (target: Lang) => alternates?.[target] ?? homePath(target);
---

<nav aria-label={t('lang.switcherLabel')} class:list={['flex items-center text-[15px]', className]}>
  {
    languages.map((target, index) => (
      <>
        {index > 0 && (
          <span aria-hidden="true" class="px-0.5 text-text-muted">
            /
          </span>
        )}
        {target === lang ? (
          <span
            aria-current="true"
            class="inline-flex min-h-9 min-w-11 items-center justify-center font-bold text-text underline decoration-accent decoration-2 underline-offset-[6px]"
          >
            <span aria-hidden="true">{target.toUpperCase()}</span>
            <span class="sr-only">
              {t(`lang.${target}` as const)} ({t('lang.current')})
            </span>
          </span>
        ) : (
          <a
            href={hrefFor(target)}
            hreflang={target}
            lang={target}
            class="lang-link inline-flex min-h-9 min-w-11 items-center justify-center rounded-md font-semibold text-text-muted underline decoration-transparent decoration-2 underline-offset-[6px] transition-colors duration-160"
          >
            <span aria-hidden="true">{target.toUpperCase()}</span>
            <span class="sr-only">{t(`lang.${target}` as const)}</span>
          </a>
        )}
      </>
    ))
  }
</nav>

<style>
  @media (hover: hover) {
    .lang-link:hover {
      color: var(--color-text);
      text-decoration-color: var(--color-border-strong);
    }
  }
  .lang-link:active {
    color: var(--color-accent-strong);
    text-decoration-color: currentColor;
  }
  .lang-link:focus-visible {
    outline-offset: -2px;
  }
</style>
