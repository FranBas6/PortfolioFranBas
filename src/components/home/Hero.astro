---
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar/fran-pixel-art.png';
import heroSceneSource from '../../assets/illustrations/hero-scene.svg?raw';
import Icon from '../ui/Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { sections, type Lang } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  site: CollectionEntry<'site'>['data'];
  skillName: Map<string, string>;
}

const { lang, site, skillName } = Astro.props;
const t = useTranslations(lang);

// The three ideas share the platform colours, in this order: web, mobile, AI.
const highlightColour = ['bg-editor-blue', 'bg-editor-green', 'bg-editor-purple'];

// The scene is inlined, not an <img>: an animated SVG image is repainted whole
// on every frame (~5 % of a core), while inline its animations are nearly free.
// The content credential stays in the source file; the copy in the page drops it.
const heroScene = heroSceneSource
  .replace(/<metadata>[\s\S]*?<\/metadata>/, '')
  .replace(' xmlns:c2pa="http://c2pa.org/manifest"', '')
  .replace('<svg ', '<svg class="aspect-[5/4] h-auto w-full" ');
---

<section aria-labelledby="hero-title" class="bg-hero">
  <div
    class="container-site grid items-center gap-16 pt-12 pb-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:pt-28 lg:pb-32"
  >
    <div>
      <!-- Below lg there is no scene: the avatar goes above the name. -->
      <span class="hero-avatar hero-avatar-top">
        <Image src={avatar} alt={t('hero.avatarAlt')} widths={[192, 288]} sizes="96px" loading="lazy" />
      </span>
      <h1
        id="hero-title"
        class="text-[40px] leading-[1.1] font-extrabold tracking-[-0.025em] lg:text-[64px] lg:leading-[1.05] lg:tracking-[-0.03em]"
      >
        {site.name}
      </h1>
      <p
        class="mt-3 text-xl leading-[1.3] font-bold text-accent lg:mt-4 lg:text-[26px] lg:tracking-[-0.01em]"
      >
        {site.role}
      </p>
      <p
        class="mt-5 max-w-[34em] text-lg font-medium text-text-secondary lg:mt-6 lg:text-xl"
      >
        {site.tagline}
      </p>
      <ul class="mt-7 flex flex-col gap-2.5 lg:flex-row lg:flex-wrap lg:gap-x-7 lg:gap-y-3">
        {
          site.highlights.map((item, index) => (
            <li class="flex items-center gap-2.5 font-semibold">
              <span
                aria-hidden="true"
                class:list={['size-2.5 shrink-0 rounded-[3px]', highlightColour[index]]}
              />
              {item}
            </li>
          ))
        }
      </ul>
      <div class="mt-7">
        <p id="main-stack" class="text-sm font-semibold text-text-muted">{t('hero.mainStack')}</p>
        <ul aria-labelledby="main-stack" class="mt-2.5 flex flex-wrap gap-2">
          {site.mainStack.map((id) => <li class="tag-tech">{skillName.get(id)}</li>)}
        </ul>
      </div>
      <div class="mt-9 flex flex-col gap-4 lg:flex-row lg:items-center lg:gap-4">
        <div class="flex flex-wrap gap-3">
          <a href={`#${sections.projects[lang]}`} class="btn btn-primary flex-auto lg:flex-none">
            {t('hero.viewProjects')}
          </a>
          <a href={site.cv} class="btn btn-secondary flex-auto lg:flex-none">
            <Icon name="download" />
            {t('hero.downloadCv')}
          </a>
        </div>
        <span aria-hidden="true" class="hidden h-7 w-px bg-border lg:block"></span>
        <div class="flex gap-3">
          <a href={site.links.github} class="icon-btn" aria-label="GitHub">
            <Icon name="github" size={20} />
          </a>
          <a href={site.links.linkedin} class="icon-btn" aria-label="LinkedIn">
            <Icon name="linkedin" size={20} />
          </a>
        </div>
      </div>
    </div>

    <div class="hero-scene relative hidden lg:block">
      <Fragment set:html={heroScene} />
      <!-- From lg the avatar floats in the empty night sky, top right of the scene. -->
      <span class="hero-avatar hero-avatar-sky">
        <Image
          src={avatar}
          alt={t('hero.avatarAlt')}
          widths={[192, 288, 384]}
          sizes="(min-width: 80rem) 150px, 12vw"
          loading="lazy"
        />
      </span>
    </div>
  </div>
</section>

<style is:global>
  /*
   * Hero scene animations (docs/design-system.md, "Ilustraciones y recursos").
   * Global because the SVG comes in through set:html; every name has the hs- prefix.
   */
  .hs-glow {
    animation: hs-breathe 9s ease-in-out infinite;
  }
  .hs-glow-phone {
    animation: hs-breathe 7s ease-in-out -3s infinite;
  }
  .hs-beam {
    animation: hs-beam 7s ease-in-out infinite;
  }
  .hs-bulb {
    animation: hs-bulb 7s ease-in-out infinite;
  }
  .hs-bar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: hs-bar 6s ease-in-out infinite;
  }
  .hs-d1 { animation-delay: -0.7s; }
  .hs-d2 { animation-delay: -1.4s; }
  .hs-d3 { animation-delay: -2.1s; }
  .hs-d4 { animation-delay: -2.8s; }
  .hs-d5 { animation-delay: -3.5s; }
  .hs-led {
    animation: hs-pulse 3.2s ease-in-out infinite;
  }
  .hs-led-r {
    animation: hs-pulse 3.2s ease-in-out -1.6s infinite;
  }
  .hs-steam {
    opacity: 0;
    animation: hs-steam 3.2s ease-out infinite;
  }
  .hs-s2 { animation-delay: 1.6s; }
  .hs-cursor {
    animation: hs-blink 1.1s steps(1) infinite;
  }
  @keyframes hs-breathe {
    0%, 100% { opacity: 0.42; }
    50% { opacity: 0.26; }
  }
  @keyframes hs-beam {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.75; }
  }
  @keyframes hs-bulb {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.82; }
  }
  @keyframes hs-bar {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.7); }
  }
  @keyframes hs-pulse {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 0.35; }
  }
  @keyframes hs-steam {
    0% { opacity: 0; transform: translateY(4px); }
    30% { opacity: 0.45; }
    100% { opacity: 0; transform: translateY(-16px); }
  }
  @keyframes hs-blink {
    50% { opacity: 0; }
  }
  /*
   * Avatar: gradient ring in the site's blue and purple, a dark rim and a glow
   * like the screen's. Lazy on purpose: each copy is hidden on the other side
   * of lg, and a lazy image that is not rendered is never fetched.
   */
  .hero-avatar {
    display: block;
    aspect-ratio: 1;
    padding: 3px;
    border-radius: 50%;
    background: linear-gradient(135deg, #82aaff 0%, #a5b4fc 45%, #c792ea 100%);
    box-shadow:
      0 18px 60px -14px rgba(110, 140, 255, 0.65),
      0 0 90px -20px rgba(199, 146, 234, 0.45);
  }
  .hero-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 3px solid #0c0b22;
  }
  .hero-avatar-top {
    width: 96px;
    margin-bottom: 20px;
    /* Here, not with lg:hidden: unlayered CSS would beat Tailwind's utilities. */
    @media (width >= 64rem) {
      display: none;
    }
  }
  .hero-avatar-sky {
    position: absolute;
    top: 6%;
    right: 3%;
    width: 27%;
    animation: hs-float 6s ease-in-out infinite;
  }
  @keyframes hs-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scene * {
      animation: none !important;
    }
    .hero-avatar-sky {
      animation: none;
    }
    .hero-scene .hs-steam {
      opacity: 0.3;
    }
  }
</style>
