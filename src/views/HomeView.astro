---
/* Home page, shared by /es/ and /en/. */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/home/Contact.astro';
import Experience from '../components/home/Experience.astro';
import Hero from '../components/home/Hero.astro';
import Projects from '../components/home/Projects.astro';
import Skills from '../components/home/Skills.astro';
import { staticAlternates, type Lang } from '../i18n/routes';
import { getProjects } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const required = <T,>(entry: T | undefined, what: string): T => {
  if (!entry) throw new Error(`Missing content: ${what}`);
  return entry;
};
const site = required(await getEntry('site', lang), `site/${lang}.yaml`).data;
const experience = required(await getEntry('experience', lang), `experience/${lang}.yaml`).data;

const skillGroups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const skillName = new Map(
  skillGroups.flatMap((group) => group.data.items.map((item) => [item.id, item.name] as const)),
);
const projects = await getProjects(lang);

// Structured data for the person. No employer, on purpose (docs/fleetx-rules.md).
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: new URL(staticAlternates.home[lang], Astro.site).href,
  sameAs: [site.links.github, site.links.linkedin],
};
---

<BaseLayout
  lang={lang}
  title={site.seo.title}
  description={site.seo.description}
  alternates={staticAlternates.home}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <Hero lang={lang} site={site} skillName={skillName} />
  <Projects lang={lang} projects={projects} skillName={skillName} />
  <Experience lang={lang} experience={experience} skillName={skillName} />
  <Skills lang={lang} groups={skillGroups} languages={site.languages} />
  <Contact lang={lang} site={site} />
</BaseLayout>
