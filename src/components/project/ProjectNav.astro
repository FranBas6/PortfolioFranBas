---
/*
 * End of a project page: "¿Hablamos?" and the previous / next project.
 * With a single neighbour the two cards share a row (mobile: neighbour
 * first). With both neighbours, "¿Hablamos?" takes its own row underneath.
 */
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { projectPath, sectionPath, type Lang } from '../../i18n/routes';
import { useTranslations, type Project } from '../../i18n/utils';

interface Props {
  lang: Lang;
  previous?: Project;
  next?: Project;
}

const { lang, previous, next } = Astro.props;
const t = useTranslations(lang);
const neighbours = [
  previous && { project: previous, label: t('project.previous') },
  next && { project: next, label: t('project.next') },
].filter(Boolean) as { project: Project; label: string }[];
const both = neighbours.length === 2;
---

<nav aria-label={t('projects.title')} class="mt-14 mb-16 grid gap-3 lg:mt-[72px] lg:mb-24 lg:grid-cols-2 lg:gap-6">
  {
    neighbours.map(({ project, label }) => (
      <a href={projectPath(lang, project.data.slug)} class="nav-card neighbour lg:order-2">
        <span class="flex min-w-0 flex-col justify-center">
          <span class="text-sm text-text-muted">{label}</span>
          <span class="mt-1 inline-flex items-center gap-2 text-xl font-extrabold lg:text-[28px]">
            {project.data.title}
            <Icon name="arrow-right" size={22} class="arrow text-accent transition-transform duration-160" />
          </span>
        </span>
        <Image
          src={project.data.cover.src}
          alt=""
          widths={[200, 400]}
          sizes="200px"
          class="hidden aspect-[16/10] w-[200px] rounded-lg border border-border object-cover object-left-top lg:block"
        />
      </a>
    ))
  }
  <a
    href={sectionPath(lang, 'contact')}
    class:list={['nav-card talk lg:order-1', both && 'lg:order-3 lg:col-span-2']}
  >
    <span class="text-2xl font-extrabold lg:text-[36px] lg:leading-[1.1]">{t('project.contactCta')}</span>
    <span class="talk-link inline-flex items-center gap-1.5 font-bold text-accent">
      <span class="hidden lg:inline">{t('nav.contact')}</span>
      <Icon name="arrow-right" size={20} class="arrow transition-transform duration-160" />
    </span>
  </a>
</nav>

<style>
  .nav-card {
    display: flex;
    min-height: 96px;
    border-radius: 16px;
    padding: 20px;
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
    @media (width >= 64rem) {
      min-height: 160px;
      padding: 32px;
    }
  }
  .neighbour {
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .talk {
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid var(--color-border-field);
    @media (width >= 64rem) {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 12px;
    }
  }
  @media (hover: hover) {
    .neighbour:hover {
      background-color: var(--color-surface-raised);
      border-color: var(--color-border-strong);
    }
    .talk:hover {
      background-color: var(--color-surface);
    }
    .talk:hover .talk-link {
      color: var(--color-text);
      text-decoration: underline 2px var(--color-accent);
      text-underline-offset: 5px;
    }
    .nav-card:hover .arrow {
      transform: translateX(3px);
    }
  }
  .neighbour:active {
    background-color: var(--color-surface);
    border-color: var(--color-accent-strong);
  }
  .neighbour:active .arrow {
    color: var(--color-accent-strong);
  }
  .talk:active {
    background-color: var(--color-bg-base);
    border-color: var(--color-accent-strong);
  }
</style>
