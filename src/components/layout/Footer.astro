---
import { getEntry } from 'astro:content';
import { privacyPath, type Alternates, type Lang } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  alternates?: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const site = await getEntry('site', lang);
if (!site) throw new Error(`Missing src/content/site/${lang}.yaml`);
---

<footer>
  <nav aria-label={t('footer.links')}>
    <ul>
      <li><a href={site.data.links.github}>GitHub</a></li>
      <li><a href={site.data.links.linkedin}>LinkedIn</a></li>
      <li><a href={`mailto:${site.data.email}`}>{site.data.email}</a></li>
      <li><a href={privacyPath(lang)}>{t('footer.privacy')}</a></li>
    </ul>
  </nav>
  <LanguageSwitcher lang={lang} alternates={alternates} />
</footer>
