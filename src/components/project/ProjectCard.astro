---
/*
 * Project card. Vertical below lg (cover on top). From lg:
 * - featured: cover on the left, text on the right (the first project);
 * - secondary: shorter, text on the left, cover on the right.
 *
 * The whole card is clickable through the title link (::after covering the
 * card); "Demo" and "Repositorio" sit above it. One tab stop per card plus
 * the two external links.
 */
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { projectPath, type Lang } from '../../i18n/routes';
import { useTranslations, type Project } from '../../i18n/utils';

interface Props {
  lang: Lang;
  project: Project;
  variant: 'featured' | 'secondary';
  skillName: Map<string, string>;
}

const { lang, project, variant, skillName } = Astro.props;
const t = useTranslations(lang);
const data = project.data;
const featured = variant === 'featured';
const href = projectPath(lang, data.slug);
---

<article
  class:list={[
    'card relative flex w-full flex-col overflow-hidden rounded-2xl border border-border bg-surface',
    featured
      ? 'lg:grid lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]'
      : 'lg:grid lg:grid-cols-[minmax(0,1fr)_400px]',
  ]}
>
  <div
    class:list={[
      'relative border-b border-border lg:border-b-0',
      featured ? 'lg:min-h-[420px] lg:border-r' : 'lg:order-2 lg:min-h-[250px] lg:border-l',
    ]}
  >
    <Image
      src={data.cover.src}
      alt={data.cover.alt}
      widths={featured ? [480, 720, 960, 1320] : [480, 720, 960]}
      sizes={featured
        ? '(min-width: 1024px) 660px, (min-width: 768px) 50vw, 100vw'
        : '(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw'}
      class="aspect-[16/10] h-auto w-full object-cover object-left-top lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
    />
  </div>

  <div
    class:list={[
      'flex flex-1 flex-col p-5 md:p-7',
      featured ? 'lg:gap-5 lg:p-10' : 'lg:gap-4 lg:px-8 lg:py-7',
    ]}
  >
    <ul class="flex flex-wrap gap-2">
      {
        data.platforms.map((platform) => (
          <li class="tag-platform" data-platform={platform}>
            {t(`platform.${platform}`)}
          </li>
        ))
      }
    </ul>
    <div class="mt-5 lg:mt-0">
      <h3
        class:list={[
          'text-xl leading-[1.25] font-bold lg:text-[22px]',
          featured && 'lg:text-[32px] lg:leading-[1.15] lg:font-extrabold lg:tracking-[-0.02em]',
        ]}
      >
        <a href={href} class="card-link">{data.title}</a>
      </h3>
      <p
        class:list={[
          'mt-2 text-text-secondary lg:text-[17px]',
          featured ? 'lg:mt-3 lg:text-lg' : 'lg:max-w-[36em]',
        ]}
      >
        {data.summary}
      </p>
    </div>
    <ul class="mt-5 flex flex-wrap gap-2 md:mb-6 lg:mt-0 lg:mb-0">
      {
        data.stack.slice(0, 5).map((id) => (
          <li class="tag-tech tag-tech-on-card">{skillName.get(id)}</li>
        ))
      }
    </ul>
    <div class="mt-6 flex flex-wrap items-center gap-x-6 border-t border-border pt-2 md:mt-auto">
      <span aria-hidden="true" class="see-project inline-flex min-h-11 items-center gap-1.5 font-bold text-accent">
        {t('projects.viewProject')}
        <Icon name="arrow-right" class="arrow transition-transform duration-160" />
      </span>
      <a
        href={data.links.demo}
        target="_blank"
        rel="noopener"
        class="card-ext link-underline relative z-10 inline-flex min-h-11 items-center gap-1 font-semibold text-text-secondary"
      >
        {t('projects.demo')}
        <Icon name="external" size={14} />
        <span class="sr-only">{t('link.newTab')}</span>
      </a>
      <a
        href={data.links.repo}
        target="_blank"
        rel="noopener"
        class="card-ext link-underline relative z-10 inline-flex min-h-11 items-center gap-1 font-semibold text-text-secondary"
      >
        {t('projects.repo')}
        <Icon name="external" size={14} />
        <span class="sr-only">{t('link.newTab')}</span>
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card-link:focus-visible {
    outline: none;
  }
  .card:has(.card-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    background-color: var(--color-surface-raised);
    border-color: var(--color-border-strong);
  }
  @media (hover: hover) {
    /* Hovering Demo or Repositorio only highlights that link. */
    .card:hover:not(:has(.card-ext:hover)) {
      background-color: var(--color-surface-raised);
      border-color: var(--color-border-strong);
      box-shadow: 0 24px 64px -24px rgba(80, 130, 255, 0.45);
    }
    .card:hover:not(:has(.card-ext:hover)) .see-project {
      color: var(--color-text);
      text-decoration: underline 2px var(--color-accent);
      text-underline-offset: 5px;
    }
    .card:hover:not(:has(.card-ext:hover)) .arrow {
      transform: translateX(2px);
    }
  }
  .card:has(.card-link:active) {
    background-color: var(--color-surface);
    border-color: var(--color-accent-strong);
    box-shadow: none;
  }
  .card:has(.card-link:active) .see-project {
    color: var(--color-accent-strong);
  }
</style>
