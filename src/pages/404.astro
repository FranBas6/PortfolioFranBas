---
/*
 * Bilingual 404, served by Netlify for any unknown URL. Not indexed.
 * The visitor's language is unknown, so both are shown, English first
 * (x-default), each block with its own lang. No navigation, only the name bar.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { homePath, type Lang } from '../i18n/routes';
import { ui } from '../i18n/ui';

const blocks: { lang: Lang; heading: 'h1' | 'h2' }[] = [
  { lang: 'en', heading: 'h1' },
  { lang: 'es', heading: 'h2' },
];
---

<BaseLayout
  lang="en"
  title={`404 · ${ui.en['notFound.title']} · ${ui.es['notFound.title']}`}
  description={ui.en['notFound.text']}
  noindex
  chrome="minimal"
>
  <section class="bg-hero flex min-h-full items-center">
    <div class="container-site py-16 lg:py-24">
      <p class="text-sm font-bold tracking-[0.08em] text-accent uppercase">{ui.en['notFound.label']}</p>
      <div class="mt-6 grid gap-9 lg:mt-8 lg:grid-cols-2 lg:gap-0">
        {
          blocks.map(({ lang, heading: Heading }, index) => (
            <div
              lang={lang}
              class:list={[
                index > 0 && 'border-t border-border pt-9 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-12',
                index === 0 && 'lg:pr-12',
              ]}
            >
              <Heading class="text-[32px] leading-[1.1] font-extrabold tracking-[-0.02em] lg:text-5xl lg:leading-[1.05]">
                {ui[lang]['notFound.title']}
              </Heading>
              <p class="mt-3 text-lg text-text-secondary lg:mt-4 lg:text-xl">{ui[lang]['notFound.text']}</p>
              <a href={homePath(lang)} class="btn btn-primary mt-6 lg:mt-8">
                {ui[lang]['notFound.home']}
                <Icon name="arrow-right" />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
